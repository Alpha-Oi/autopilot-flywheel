# Пример переменных окружения для Autopilot Flywheel
# Скопируйте этот файл как .env и заполните реальными значениями

# Модель (по умолчанию gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# OpenAI API Key (если используете OpenAI)
OPENAI_API_KEY=sk-your-key-here

# Anthropic API Key (если используете Claude)
# ANTHROPIC_API_KEY=sk-ant-your-key-here
